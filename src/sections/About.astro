---
import {Image} from "astro:assets";
import author from "../assets/images/author.webp";
---

<section class="about" id="sobre-el-autor">
    <div class="aboutInner container">
        <div class="avatarWrap" data-about-avatar>
            <Image
                src={author}
                alt="Rigoberto Martínez Bermúdez"
                widths={[168, 336]}
                sizes="168px"
                class="avatar"
            />
        </div>

        <div class="bio">
            <p class="eyebrow" data-about-item>Acerca de</p>
            <h2 class="name serif" data-about-item>Rigoberto Martínez Bermúdez</h2>
            <p class="text" data-about-item>
                Administrador de Empresas, con posgrado en formulación y evaluación de proyectos industriales y estudios en
                alta gerencia. Amplia experiencia en cargos administrativos y técnicos, con responsabilidades en la gestión
                de proyectos de diferente naturaleza. Formador y autor de publicaciones sobre eficiencia administrativa,
                tramitomanía, gestión de procesos y procedimientos, humanización en salud, servicio al ciudadano y cliente interno.
            </p>
        </div>
    </div>
</section>

<style>
    .about {
        min-height: 800px;
        display: flex;
        align-items: center;
        padding: 96px 0;
        scroll-margin-top: 40px;
    }

    .aboutInner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
    }

    .avatarWrap {
        position: relative;
        width: 168px;
        height: 168px;
        border-radius: 50%;
        box-shadow: var(--shadow-card);
    }

    /* Anillo de acento que rodea el retrato */
    .avatarWrap::after {
        content: '';
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        border: 1px solid var(--c-linea);
    }

    .avatarWrap :global(.avatar) {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        object-position: center 15%;
    }

    .bio {
        width: min(640px, 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        text-align: center;
    }

    .name {
        font-weight: 600;
        font-size: clamp(28px, 2.4vw, 34px);
        letter-spacing: -0.015em;
        color: var(--c-tinta);
    }

    .text {
        font-size: 16px;
        line-height: 1.65;
        color: var(--c-grafito);
    }

    @media (max-width: 767px) {
        .about {
            min-height: auto;
            padding: 72px 0;
        }
    }
</style>
