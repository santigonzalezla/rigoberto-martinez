---
import ContactForm from "../components/contact/ContactForm";
import MailIcon from "../assets/svg/mail.svg";

const email = "contacto@rigobertomartinezautor.com";
---

<section class="contact" id="contacto">
    <div class="contactRow">
        <div class="copy">
            <p class="eyebrow" data-contact-item>Hablemos</p>
            <h2 class="title serif" data-contact-item>¿Tienes preguntas sobre los libros?</h2>
            <p class="text" data-contact-item>
                Escríbeme si quieres comprar varios ejemplares, coordinar un envío especial o resolver cualquier duda
                sobre los libros.
            </p>
            <a href={`mailto:${email}`} class="emailRow" data-contact-item>
                <MailIcon width={18} height={18} class="mailIcon"/>
                <span>{email}</span>
            </a>
            <p class="note" data-contact-item>Respondo personalmente en menos de 48 horas.</p>
        </div>

        <div class="formWrap" data-contact-form>
            <ContactForm client:visible/>
        </div>
    </div>
</section>

<style>
    .contact {
        min-height: 800px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 96px var(--px);
        scroll-margin-top: 40px;
    }

    .contactRow {
        width: min(1040px, 100%);
        display: grid;
        grid-template-columns: minmax(0, 1fr) 542px;
        gap: 80px;
        align-items: start;
    }

    .copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 18px;
        padding-top: 8px;
    }

    .title {
        font-weight: 600;
        font-size: clamp(34px, 3.1vw, 44px);
        line-height: 1.12;
        letter-spacing: -0.02em;
        color: var(--c-tinta);
    }

    .text {
        font-size: 17px;
        line-height: 1.6;
        color: var(--c-grafito);
    }

    .emailRow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        font-weight: 500;
        font-size: 15px;
        letter-spacing: 0.005em;
        color: var(--c-tinta);
        background-image: linear-gradient(var(--c-terracota), var(--c-terracota));
        background-size: 0% 1px;
        background-position: 28px 80%;
        background-repeat: no-repeat;
        transition: background-size 400ms var(--ease-out);
    }

    .emailRow :global(.mailIcon) {
        flex-shrink: 0;
    }

    @media (hover: hover) and (pointer: fine) {
        .emailRow:hover {
            background-size: calc(100% - 28px) 1px;
        }
    }

    .note {
        font-size: 14px;
        line-height: 1.5;
        color: var(--c-grafito);
    }

    .formWrap {
        perspective: 1200px;
    }

    @media (max-width: 1024px) {
        .contactRow {
            grid-template-columns: 1fr;
            gap: 48px;
            max-width: 620px;
        }
    }

    @media (max-width: 767px) {
        .contact {
            min-height: auto;
            padding: 72px var(--px);
        }

        .emailRow span {
            overflow-wrap: anywhere;
        }
    }
</style>
