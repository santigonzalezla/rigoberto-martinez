<table role="presentation" cellpadding="0" cellspacing="0" border="0" {{#if fullWidth}}width="100%"{{/if}} style="margin:{{#if margin}}{{margin}}{{else}}8px 0{{/if}};">
  <tr>
    <td align="center" bgcolor="#232321" style="border-radius:999px;background:#232321;">
      <a href="{{href}}" target="_blank" style="display:inline-block;padding:15px 30px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:bold;line-height:1;color:#F4F1EC;text-decoration:none;border-radius:999px;">{{label}}</a>
    </td>
  </tr>
</table>
