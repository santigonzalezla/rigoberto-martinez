<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #EFEAE2;border-radius:14px;background:#FBFAF7;">
  {{#each items}}
  <tr>
    <td width="72" valign="top" style="padding:16px 0 16px 16px;{{#unless @first}}border-top:1px solid #EFEAE2;{{/unless}}">
      <img src="{{../assetsUrl}}/email/cover-{{id}}.jpg" width="56" height="83" alt="Portada de {{title}}" style="display:block;width:56px;height:83px;border-radius:2px 6px 6px 2px;border:0;">
    </td>
    <td valign="middle" style="padding:16px 12px;{{#unless @first}}border-top:1px solid #EFEAE2;{{/unless}}font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
      <p style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:16px;font-weight:bold;line-height:1.3;color:#232321;">{{title}}</p>
      <p style="margin:4px 0 0;font-size:13px;color:#7C6C5E;">eBook en PDF{{#if isbn}} · ISBN {{isbn}}{{/if}}</p>
    </td>
    <td valign="middle" align="right" style="padding:16px 16px 16px 0;{{#unless @first}}border-top:1px solid #EFEAE2;{{/unless}}font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:bold;color:#232321;white-space:nowrap;">
      {{price}}
    </td>
  </tr>
  {{/each}}
  <tr>
    <td colspan="2" style="padding:16px;border-top:1px solid #E4DED4;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#6B6862;">
      Total · {{itemsLabel}}
    </td>
    <td align="right" style="padding:16px;border-top:1px solid #E4DED4;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#232321;white-space:nowrap;">
      {{total}}
    </td>
  </tr>
</table>
