<!DOCTYPE html>
<html lang="es" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>{{subject}}</title>
  <style>
    @media only screen and (max-width: 620px) {
      .card { width: 100% !important; border-radius: 0 !important; }
      .px { padding-left: 24px !important; padding-right: 24px !important; }
      .stack { display: block !important; width: 100% !important; }
      .hide-mobile { display: none !important; }
    }
    a { color: #232321; }
  </style>
</head>
<body style="margin:0;padding:0;background:#F4F1EC;-webkit-text-size-adjust:100%;">
  <!-- Texto de vista previa en la bandeja de entrada -->
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">
    {{preheader}}&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F4F1EC;">
    <tr>
      <td align="center" style="padding:40px 12px;">

        <table role="presentation" class="card" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:#FFFFFF;border:1px solid #E4DED4;border-radius:20px;overflow:hidden;">

          <!-- Encabezado -->
          <tr>
            <td class="px" style="padding:32px 44px 28px;border-bottom:1px solid #EFEAE2;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td valign="middle">
                    <a href="{{siteUrl}}" style="text-decoration:none;color:#232321;">
                      <span style="display:block;font-family:Georgia,'Times New Roman',serif;font-weight:bold;font-size:22px;line-height:22px;letter-spacing:-0.4px;color:#232321;">Rigoberto</span>
                      <span style="display:block;font-family:Georgia,'Times New Roman',serif;font-weight:bold;font-size:22px;line-height:22px;letter-spacing:-0.4px;color:#232321;">Martínez</span>
                    </a>
                  </td>
                  <td valign="middle" align="right" style="font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:14px;color:#C68B84;">
                    {{eyebrow}}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Contenido -->
          <tr>
            <td class="px" style="padding:40px 44px 44px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.65;color:#4A4743;">
              {{{body}}}
            </td>
          </tr>

          <!-- Firma -->
          {{#if signature}}
          <tr>
            <td class="px" style="padding:0 44px 40px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #EFEAE2;width:100%;">
                <tr>
                  <td width="68" valign="middle" style="padding-top:24px;">
                    <img src="{{assetsUrl}}/email/author.jpg" width="56" height="56" alt="Rigoberto Martínez Bermúdez" style="display:block;width:56px;height:56px;border-radius:50%;border:0;">
                  </td>
                  <td valign="middle" style="padding-top:24px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                    <p style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:16px;font-weight:bold;color:#232321;">Rigoberto Martínez Bermúdez</p>
                    <p style="margin:2px 0 0;font-size:13px;color:#7C6C5E;">Autor y formador · Administrador de Empresas</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {{/if}}

        </table>

        <!-- Pie -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:100%;">
          <tr>
            <td align="center" style="padding:28px 24px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.7;color:#8A857D;">
              <a href="{{siteUrl}}" style="color:#6B6862;text-decoration:none;font-weight:bold;">rigobertomartinezautor.com</a>
              &nbsp;·&nbsp;
              <a href="mailto:{{contactEmail}}" style="color:#6B6862;text-decoration:none;">{{contactEmail}}</a>
              {{#if footerNote}}<br>{{footerNote}}{{/if}}
              <br>© {{year}} Rigoberto Martínez Bermúdez · Colombia
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>
