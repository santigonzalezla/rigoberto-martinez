---
import {AUTHOR_NAME, books} from "../../data/books";

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://rigobertomartinezautor.com';

const author = {
    '@type': 'Person',
    '@id': `${siteUrl}/#author`,
    name: AUTHOR_NAME,
    alternateName: 'Rigoberto Martínez',
    jobTitle: 'Autor y formador · Administrador de Empresas',
    email: 'contacto@rigobertomartinezautor.com',
    url: siteUrl,
    nationality: {'@type': 'Country', name: 'Colombia'},
    knowsAbout: ['Gestión de proyectos', 'Monitoreo de proyectos', 'Servicio al cliente interno', 'Endomarketing', 'Eficiencia administrativa', 'Gestión de procesos', 'Comportamiento humano']
};

const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebSite',
            '@id': `${siteUrl}/#website`,
            url: siteUrl,
            name: 'Rigoberto Martínez — Libros',
            inLanguage: 'es-CO',
            publisher: {'@id': `${siteUrl}/#author`}
        },
        author,
        ...books.map((book) => ({
            '@type': 'Book',
            '@id': `${siteUrl}/#${book.id}`,
            name: book.title,
            alternativeHeadline: book.subtitle,
            author: {'@id': `${siteUrl}/#author`},
            inLanguage: 'es',
            bookFormat: 'https://schema.org/EBook',
            bookEdition: book.edition,
            ...(book.isbn ? {isbn: book.isbn.replace(/-/g, '')} : {}),
            genre: book.category,
            keywords: book.keywords.join(', '),
            description: book.shortDescription,
            image: new URL(book.cover.src, siteUrl).toString(),
            offers: {
                '@type': 'Offer',
                price: book.price,
                priceCurrency: 'COP',
                availability: 'https://schema.org/InStock',
                url: `${siteUrl}/#libros`
            }
        }))
    ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>
